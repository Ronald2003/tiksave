NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported if the publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for verified upload completion, public signing, and rate limits.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SECRET=
MAX_UPLOAD_BYTES=26214400
# Optional self-hosted downloader. Local development only; production needs its own HTTPS backend.
COBALT_API_URL=
# Server only. Match the key registered in your hosted Cobalt instance.
COBALT_API_KEY=
# Optional server-only YouTube provider. Keep the Apify account on Free with overage disabled.
# Requests use 720p, a $0.10 per-run cap, and no paid proxy fallback.
APIFY_API_TOKEN=
CONTACT_EMAIL=
# Set only for tests against a disposable Supabase project/local instance.
RUN_SUPABASE_TESTS=0
